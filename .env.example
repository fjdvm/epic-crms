# Base address of the Portal (central sign-in site).
PORTAL_URL=https://portal.example.com
# The System name CREOMS is registered under in the Portal.
PORTAL_SYSTEM_NAME=CRMS
# CREOMS backend credential for the Portal (same value as the Portal's SYSTEM_SECRET_CRMS).
# Generate with `openssl rand -base64 32`. Never commit a real value.
PORTAL_SYSTEM_SECRET=
# Public origin of this app. The Portal callback is <origin>/api/portal/callback and must be registered.
CREOMS_APP_URL=http://localhost:3000
# Development and tests ONLY: act as a fully-permitted Staff member with no Portal. CREOMS refuses to
# start if this is set in production or with a non-localhost CREOMS_APP_URL.
# CREOMS_DEV_BYPASS=true

# Read-only connection string for the shared ecommerce Neon database (creoms_readonly role).
CREOMS_DATABASE_URL=

# Connection string for CREOMS's own `crms` schema (creoms_writer role, docs/db/crms-schema.sql).
CREOMS_WRITER_DATABASE_URL=
# Bearer secret for POST /api/notifications/sync (what a scheduler sends). Generate with `openssl rand -base64 32`.
CREOMS_SYNC_SECRET=
# Tests only: a role that may create and drop schemas. Tests create a throwaway schema mirroring
# crms and drop it; they never touch the real crms schema.
# CREOMS_TEST_DATABASE_URL=
