# Base address of the Portal (central sign-in site).
PORTAL_URL=https://portal.example.com
# The System name CREOMS is registered under in the Portal.
PORTAL_SYSTEM_NAME=CRMS
# CREOMS backend credential for the Portal (same value as the Portal's SYSTEM_SECRET_CRMS).
# Generate with `openssl rand -base64 32`. Never commit a real value.
PORTAL_SYSTEM_SECRET=
# Public origin of this app. The Portal callback is <origin>/api/portal/callback and must be registered.
CREOMS_APP_URL=http://localhost:3000
# Development and tests ONLY: act as a fully-permitted Staff member with no Portal. CREOMS refuses to
# start if this is set in production or with a non-localhost CREOMS_APP_URL.
# CREOMS_DEV_BYPASS=true  (then /api/dev/role?role=staff|manager|admin|ceo picks the dev user)

# Read-only connection string for the shared ecommerce Neon database (creoms_readonly role).
CREOMS_DATABASE_URL=

# Connection string for the Ticket and Message tables in the shared database (creoms_tickets role, written
# for the owner to run in the ecommerce repo's docs/sql/creoms-tickets-role.sql). Required for Staff to claim,
# release, reply to and resolve Tickets; the pages read through CREOMS_DATABASE_URL.
CREOMS_TICKETS_DATABASE_URL=

# Connection string for CREOMS's own `crms` schema (creoms_writer role, docs/db/crms-schema.sql).
CREOMS_WRITER_DATABASE_URL=
# Bearer secret for POST /api/notifications/sync (what a scheduler sends). Generate with `openssl rand -base64 32`.
CREOMS_SYNC_SECRET=
# Tests only: a role that may create and drop schemas. Tests create a throwaway schema mirroring
# crms and drop it; they never touch the real crms schema.
# CREOMS_TEST_DATABASE_URL=

# Base address of the api-gateway (Live tickets, notifications, file-storage).
CREOMS_GATEWAY_URL=https://api.buildwrite.me
# CREOMS's Caller key for the gateway, sent as `Authorization: Bearer <key>`. Server-side only: never
# prefix with NEXT_PUBLIC_. Its sha256 must be in the gateway's CALLERS secret under the "crms" entry
# with "systemCode": "CRMS" (file-storage). Its name, "crms", is the app name notifications sees.
CREOMS_GATEWAY_CALLER_KEY=
# Public origin of the storefront, for the button in the email asking a Customer to confirm a Resolved Ticket.
CREOMS_STOREFRONT_URL=

# Connection string for labelling Feedback, as the creoms_feedback role (docs/db/creoms-feedback-role.sql).
# It may write only the Sentiment columns on order_feedback, the Feedback analysis run record and the Top product.
CREOMS_FEEDBACK_DATABASE_URL=
# Secret the GitHub Actions schedules send as `Authorization: Bearer <secret>` to /api/cron/feedback-analysis, which runs
# the Feedback analysis 5 times a day (08:00, 11:00, 14:00, 17:00 and 20:00 Philippines time). Set the same value as the
# repo secret CRON_SECRET, and the repo secret CREOMS_APP_URL to this app's origin.
CRON_SECRET=
# The owner's email for error alerts: CREOMS records each server error in the audit service and emails here, at most once
# per kind of error per hour. Leave empty to record without emailing. Needs docs/db/crms-error-alerts.sql applied.
OWNER_ALERT_EMAIL=
# Groq labels each Feedback's Sentiment and chooses the Top product; Gemini is the backup when Groq fails. The owner supplies the
# keys. They live only here: the storefront never reads them. A model with an empty key or name is skipped.
GROQ_API_KEY=
GROQ_MODEL=
GOOGLE_GENERATIVE_AI_API_KEY=
GEMINI_MODEL=

# Signs the short-lived Order status credential sent to the storefront. Same value as the
# storefront's CREOMS_SERVICE_SECRET (at least 32 characters). Server-side only; never commit it.
CREOMS_SERVICE_SECRET=

# Optional separate key for short-lived direct-upload references (at least 32 characters).
# Falls back to CREOMS_SERVICE_SECRET when unset. Server-side only; rotation expires references.
CREOMS_UPLOAD_SECRET=

# Dedicated gateway-to-CREOMS credential for POST /api/notifications/signal (at least 32 characters).
# Set the same CREOMS_SIGNAL_SECRET on api-gateway. Never use the storefront's Caller key here.
CREOMS_SIGNAL_SECRET=

# IMS-to-CREOMS credential for POST /api/internal/ims-stock (at least 32 characters): the IMS pushes each Size's stock
# figures to CREOMS's stock count with it. Set the same IMS_CREOMS_SECRET on the IMS. _PREVIOUS is only for rotation.
IMS_CREOMS_SECRET=
IMS_CREOMS_SECRET_PREVIOUS=

# POS-to-CREOMS credential for GET /api/internal/pos-sales (at least 32 characters): the POS signs a short-lived token
# with it to read CREOMS's online Sales. Set the same POS_CREOMS_SECRET on the POS. _PREVIOUS is only for rotation.
POS_CREOMS_SECRET=
POS_CREOMS_SECRET_PREVIOUS=

# BUILD-TIME values (pass as `docker build --build-arg`; baked into the client bundle, so they are not secrets).
# Public origin of this app; the container image is built for it.
# NEXT_PUBLIC_APP_URL=https://crms.example.com
# Sidebar links to the other Systems. Unset keeps the built-in default for each.
# NEXT_PUBLIC_HOST_URL=
# NEXT_PUBLIC_CRMS_URL=
# NEXT_PUBLIC_HRMS_URL=
# NEXT_PUBLIC_POS_URL=
# NEXT_PUBLIC_IMS_URL=

# RUNTIME values set by the container platform, not by an operator: PORT (default 3000), HOSTNAME (0.0.0.0).
