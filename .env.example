# Base address of the Portal (central sign-in site).
PORTAL_URL=https://portal.example.com
# The System name CREOMS is registered under in the Portal.
PORTAL_SYSTEM_NAME=CRMS
# CREOMS backend credential for the Portal (same value as the Portal's SYSTEM_SECRET_CRMS).
# Generate with `openssl rand -base64 32`. Never commit a real value.
PORTAL_SYSTEM_SECRET=
# Public origin of this app. The Portal callback is <origin>/api/portal/callback and must be registered.
CREOMS_APP_URL=http://localhost:3000
